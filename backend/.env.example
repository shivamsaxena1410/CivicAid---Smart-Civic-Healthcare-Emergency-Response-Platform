# CivicConnect Backend Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL with PostGIS)
# For local Docker:
DATABASE_URL="postgresql://civic_user:civic_password_2026@localhost:5432/civicconnect_db?schema=public"
# For Supabase / Render / Cloud:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?schema=public"

# Redis Configuration (Cache, Throttler & Token Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or single URL (e.g. Upstash):
# REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET="civicconnect_super_secret_access_jwt_key_2026_production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="civicconnect_super_secret_refresh_jwt_key_2026_production"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# External AI Provider (Google Gemini or OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email Notifications (Optional - Resend or SMTP)
RESEND_API_KEY=""
MAIL_FROM="noreply@civicconnect.org"
